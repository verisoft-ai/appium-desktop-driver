# C# build artifacts
csharp/**/bin/
csharp/**/obj/

# IEBridge built binary and intermediate output — built at publish time, not committed
iebridge/IEBridge.exe
iebridge/x86/
native/

# WinForms test-fixture app — built at test time via build:winform-test-app, not committed
test-apps/winform-combo/bin/
test-apps/winform-combo/obj/

# Java Swing test-fixture app — compiled ad hoc at test time (javac), not committed
test-apps/java-swing-form/*.class

# DevExpress grid owner-draw test-fixture app — source is checked in, but build output/obj is
# not (built at test time via build:devexpress-test-app)
test-apps/devexpress-grid-ownerdraw/bin/
test-apps/devexpress-grid-ownerdraw/obj/

# Minimal owner-draw test-fixture app — source is checked in, build output/obj is not
test-apps/minimal-ownerdraw-winforms/bin/
test-apps/minimal-ownerdraw-winforms/obj/

# 32-bit twin of the above — proves the .NET bridge's x86 injection path
test-apps/minimal-ownerdraw-x86/bin/
test-apps/minimal-ownerdraw-x86/obj/

# OwnerDraw gallery test-fixture app — source is checked in, build output/obj is not
test-apps/ownerdraw-gallery/bin/
test-apps/ownerdraw-gallery/obj/

# DevExpress-specific elements gallery test-fixture app — source is checked in, build output/obj
# is not (built at test time via build:devexpress-elements-gallery-test-app)
test-apps/devexpress-elements-gallery/bin/
test-apps/devexpress-elements-gallery/obj/

# WPF minimal test-fixture app — source is checked in, build output/obj is not (built at test time
# via build:wpf-minimal-test-app)
test-apps/wpf-minimal/bin/
test-apps/wpf-minimal/obj/

# WPF DataGrid templated-column test-fixture app — source is checked in, build output/obj is not
# (built at test time via build:wpf-datagrid-template-test-app)
test-apps/wpf-datagrid-template/bin/
test-apps/wpf-datagrid-template/obj/

# C++/CLI native bridge build artifacts — MSBuild's default IntDir nests under a
# project-name subfolder (dotnet-bridge-agent/BridgeAgent/x64/Release/...), not directly under
# dotnet-bridge-agent/x64/ as a naive guess would suggest. Final output lands in native/win-x64/
# (already ignored above). Also ignore the per-user VS project settings and .vs/ cache dir that
# appear once this is opened in an actual Visual Studio instance.
dotnet-bridge-agent/BridgeAgent/
dotnet-bridge-agent/x64/
dotnet-bridge-agent/Debug/
dotnet-bridge-agent/Release/
dotnet-bridge-agent/*.vcxproj.user
.vs/

# E2E debug output — generated by test/e2e/extension-vision-annotated.e2e.ts
test/e2e/output/

