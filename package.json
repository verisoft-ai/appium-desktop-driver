{
  "name": "appium-desktop-driver",
  "version": "2.6.1",
  "description": "Appium driver for Windows",
  "keywords": [
    "appium",
    "automated testing",
    "desktop",
    "desktop automation",
    "uiautomation",
    "verisoft",
    "windows"
  ],
  "bugs": {
    "url": "https://github.com/verisoft-ai/appium-desktop-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "Automate The Planet",
  "repository": {
    "type": "git",
    "url": "https://github.com/verisoft-ai/appium-desktop-driver.git"
  },
  "files": [
    "build/lib/**/*",
    "iedriver/**/*",
    "iebridge/IEBridge.exe",
    "native/win-x64/DesktopDriverServer.exe",
    "native/win-x64/appium-desktop-agent.jar",
    "native/win-x64/appium-dotnet-bridge.dll",
    "native/win-x86/appium-dotnet-bridge.dll",
    "native/win-x86/BridgeInjectorX86Stub.exe",
    "native/win-x64/appium-dotnet-profiler.dll",
    "native/win-x86/appium-dotnet-profiler.dll",
    "native/win-x64/appium-dotnet-bridge-core.dll",
    "native/win-x86/appium-dotnet-bridge-core.dll",
    "scripts/postinstall.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "build/lib/driver.js",
  "scripts": {
    "build": "tsc -b",
    "build:native": "dotnet publish csharp/DesktopDriverServer/DesktopDriverServer.csproj -c Release -o native/win-x64/",
    "build:iebridge": "dotnet publish csharp/IEBridge/IEBridge.csproj -r win-x86 -c Release -o iebridge/x86 && node -e \"const fs=require('fs');fs.copyFileSync('iebridge/x86/IEBridge.exe','iebridge/IEBridge.exe');\"",
    "build:java-agent": "cd java-agent && build.bat",
    "build:dotnet-bridge": "cd dotnet-bridge-agent && build.bat",
    "build:dotnet-bridge-x86-stub": "dotnet publish csharp/BridgeInjectorX86Stub/BridgeInjectorX86Stub.csproj -c Release -r win-x86 -o native/win-x86/ --self-contained",
    "build:dotnet-bridge-core": "dotnet publish dotnet-bridge-agent-core/BridgeAgentCore.csproj -c Release -r win-x64 -o native/win-x64/ --self-contained false",
    "build:dotnet-bridge-core-x86": "dotnet publish dotnet-bridge-agent-core/BridgeAgentCore.csproj -c Release -r win-x86 -o native/win-x86/ --self-contained false",
    "build:dotnet-bridge-profiler": "cd dotnet-bridge-profiler && build.bat",
    "build:all": "npm run build:java-agent && npm run build:dotnet-bridge && npm run build:dotnet-bridge-x86-stub && npm run build:dotnet-bridge-core && npm run build:dotnet-bridge-core-x86 && npm run build:dotnet-bridge-profiler && npm run build:native && npm run build:iebridge && npm run build",
    "watch": "tsc -b --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "test": "npx vitest run",
    "test:e2e": "npx vitest run --config vitest.e2e.config.mts",
    "postinstall": "node scripts/postinstall.js",
    "pack:dist": "node scripts/pack-dist.js"
  },
  "dependencies": {
    "@appium/css-locator-to-native": "^1.0.6",
    "@appium/support": "^7.2.6",
    "appium-chromedriver": "^8.3.1",
    "asyncbox": "^6.3.5",
    "bezier-easing": "^2.1.0",
    "koffi": "^2.14.1",
    "xpath-analyzer": "^3.0.1"
  },
  "devDependencies": {
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/tsconfig": "^1.1.0",
    "@appium/types": "^1.1.0",
    "@types/node": "^24.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "webdriverio": "^9.30.1"
  },
  "peerDependencies": {
    "appium": "^3.0.0-rc.2"
  },
  "appium": {
    "driverName": "desktopdriver",
    "automationName": "DesktopDriver",
    "platformNames": [
      "Windows"
    ],
    "mainClass": "AppiumDesktopDriver"
  }
}
