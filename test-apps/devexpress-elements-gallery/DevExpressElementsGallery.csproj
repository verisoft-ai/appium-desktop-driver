<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DevExpressElementsGallery</AssemblyName>
    <RootNamespace>DevExpressElementsGallery</RootNamespace>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="DevExpress.Win.Grid" Version="25.1.*-*" />
    <PackageReference Include="DevExpress.Win.TreeList" Version="25.1.*-*" />
  </ItemGroup>

</Project>
