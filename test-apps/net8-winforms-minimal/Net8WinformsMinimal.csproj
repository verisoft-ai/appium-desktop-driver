<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CoreCLR (.NET 5+) twin of test-apps/winform-combo — see
    dotnet-bridge-agent/CORECLR-BRIDGE-SPEC.md. Deliberately net8.0-windows (not net48): the
    whole point of this fixture is to load coreclr.dll instead of clr.dll, so
    BridgeInjector.DetectClrFramework routes attachDotnetBridge to CoreClrAttacher instead of the
    Win32-injection path. No third-party dependency, same TextBox/Button/owner-drawn-list shape
    as wpf-minimal/winform-combo so the same style of assertions apply once the profiler-attach
    path is fully verified (see dotnet-bridge-coreclr.e2e.ts).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Net8WinformsMinimal</AssemblyName>
    <RootNamespace>Net8WinformsMinimal</RootNamespace>
  </PropertyGroup>

</Project>
