<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CoreCLR (.NET 8) WPF twin of net8-winforms-minimal — see
    dotnet-bridge-agent/CORECLR-BRIDGE-SPEC.md. Exists to prove/fix the profiler's anchor-method
    gap: ProfilerCallback.cpp's kAnchorCandidates only lists System.Windows.Forms.Control.WndProc,
    so a pure-WPF process (no System.Windows.Forms module ever loaded) never satisfies
    ScanLoadedModulesForAnchor, RequestReJIT is never called, and attach times out after 15s
    waiting on a port file that's never written. Deliberately no System.Windows.Forms reference —
    UseWPF only — so this fixture can't accidentally satisfy the existing WinForms anchor.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Net8WpfMinimal</AssemblyName>
    <RootNamespace>Net8WpfMinimal</RootNamespace>
  </PropertyGroup>

</Project>
